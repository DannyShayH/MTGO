STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://redis:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa-backend?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=medusa-backend

# The partner app's public URL. Staff invite links copied from Admin point to
# its invitation page (<PARTNER_PUBLIC_URL>/invite?token=...). Defaults to
# http://localhost:8100, the partner app's development port.
PARTNER_PUBLIC_URL=http://localhost:8100
# Also used for Restaurant staff and Delivery agent password recovery links.

# Disposable verification only; the captured mailbox route is disabled unless
# E2E_DISPOSABLE=1.
STOREFRONT_PUBLIC_URL=http://localhost:8000
TEST_MAILBOX_FAIL_RECIPIENT=
TEST_MAILBOX_KEY=

# MEDUSA_CI_HTTP is set only by the isolated browser verification harness.
# Do not enable its insecure local HTTP cookies in a deployed environment.

# Optional: the demonstration seed (src/scripts/seed-demo-restaurant.ts) makes
# this login authorized staff of Pizzeria Nørrebro, for signing in to the
# partner app. Use development values only.
SEED_STAFF_EMAIL=
SEED_STAFF_PASSWORD=
SEED_AGENT_EMAIL=
SEED_AGENT_PASSWORD=
SEED_AGENT_POSTAL_CODES=

# Staging containers (deploy/staging/compose.yaml) set these. MEDUSA_BACKEND_URL
# is the backend's public origin, used for upload URLs. MEDUSA_WORKER_MODE
# (server, worker or shared) is read by Medusa itself; DISABLE_MEDUSA_ADMIN=true
# keeps the dashboard off the worker. Leave all three unset in development.
MEDUSA_BACKEND_URL=
MEDUSA_WORKER_MODE=
DISABLE_MEDUSA_ADMIN=

# Optional local request metrics. start/develop only, one HTTP process.
# Loopback by default. Bind 0.0.0.0 only inside an isolated container network
# without publishing the metrics port. Keep PORT consistent with the API port;
# use PORT rather than a CLI --port override. Cluster mode is not supported.
MTOGO_METRICS_ENABLED=
MTOGO_METRICS_HOST=127.0.0.1
MTOGO_METRICS_PORT=9464

# openrouteservice free Standard key (no payment card) for delivery distances,
# from the HeiGIT account dashboard (sign up at https://openrouteservice.org)
# (#191). Without it the agent workspace shows "Distance unavailable" and
# nothing is sent to the provider. Keep it server-side; never in the browser.
ORS_API_KEY=
# Tests only: the HTTP specs point this at a local stand-in for openrouteservice.
# Leave it unset to use https://api.heigit.org. Test runs ignore ORS_API_KEY.
ORS_BASE_URL=

# Feature flags (ADR-0022), read once at boot: change and restart, no build.
# Each Feature is off unless switched on.
# Restaurant statements (#52). Off, the partner Order detail shows no
# financial basis (#226); purchase facts are still recorded at placement.
MTOGO_FF_RESTAURANT_STATEMENTS=true

# Local development uses apps/backend/static; no Tigris account or key is needed.
# The staging-only Tigris key belongs in deploy/staging/.env.template on the Droplet.

# Delivery agent Bonus points (#236); backend default is off.
MTOGO_FF_AGENT_BONUS=false
# Operations monitoring (#54): the Admin Operations page; backend default is off.
MTOGO_FF_OPERATIONS_MONITORING=false
