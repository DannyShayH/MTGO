STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://redis:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa-backend?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=medusa-backend

# The partner app's public URL. Staff invite links copied from Admin point to
# its invitation page (<PARTNER_PUBLIC_URL>/invite?token=...). Defaults to
# http://localhost:8100, the partner app's development port.
PARTNER_PUBLIC_URL=http://localhost:8100

# Disposable verification only; the captured mailbox route is disabled unless
# E2E_DISPOSABLE=1.
STOREFRONT_PUBLIC_URL=http://localhost:8000
TEST_MAILBOX_FAIL_RECIPIENT=
TEST_MAILBOX_KEY=

# MEDUSA_CI_HTTP is set only by the isolated browser verification harness.
# Do not enable its insecure local HTTP cookies in a deployed environment.

# Optional: the demonstration seed (src/scripts/seed-demo-restaurant.ts) makes
# this login authorized staff of Pizzeria Nørrebro, for signing in to the
# partner app. Use development values only.
SEED_STAFF_EMAIL=
SEED_STAFF_PASSWORD=
