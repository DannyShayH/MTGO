---
import { metrics, moment } from "../lib/flow-view.ts"
---
{metrics.wipBreaches.length ? <div class="flow-table-wrap not-content" role="region" aria-label="WIP limit breach periods" tabindex="0">
  <table class="flow-table">
    <thead><tr><th scope="col">Column</th><th scope="col">Limit</th><th scope="col">Start</th><th scope="col">End</th><th scope="col">Peak excess</th></tr></thead>
    <tbody>{metrics.wipBreaches.map((breach) => <tr><th scope="row">{breach.column}</th><td>{breach.limit}</td><td><time datetime={breach.start}>{moment(breach.start)}</time></td><td>{breach.end ? <time datetime={breach.end}>{moment(breach.end)}</time> : "Ongoing at collection"}</td><td>{breach.peakExcess}</td></tr>)}</tbody>
  </table>
</div> : <p>No limit breaches in the available history.</p>}
