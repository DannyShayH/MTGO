---
import metrics from "../generated/flow-metrics.json"
import { LIMITS } from "../../scripts/flow-metrics.ts"
import type { IssueLink } from "../../scripts/flow-metrics.ts"

const project = "https://github.com/users/DannyShayH/projects/2"
const timeZone = "Europe/Copenhagen"

const observed = new Intl.DateTimeFormat("en-GB", {
  timeZone,
  year: "numeric",
  month: "long",
  day: "numeric",
  hour: "2-digit",
  minute: "2-digit",
  timeZoneName: "short",
}).format(new Date(metrics.observedAt))

const day = new Intl.DateTimeFormat("en-GB", {
  timeZone: "UTC",
  day: "numeric",
  month: "short",
})
const range = (start: string, end: string) =>
  `${day.format(new Date(start))} to ${day.format(new Date(end))}`

const columns = [
  { id: "in-progress", label: "In Progress", kind: "wip", data: metrics.inProgress },
  { id: "delivery-initiated", label: "Delivery Initiated", kind: "wip", data: metrics.deliveryInitiated },
  { id: "ready", label: "Ready", kind: "queue", data: metrics.ready },
] as const

const percent = (part: number, whole: number) => Math.min(100, (part / whole) * 100)
---

<div class="flow-banner not-content">
  <strong>Sample data</strong>
  <span>
    Saved from <a href={project}>Project #2</a> on
    <time datetime={metrics.observedAt}>{observed}</time>. This is also the time of the last
    update. These numbers do not update when the board changes.
  </span>
</div>

<h2 id="current-wip-and-ready-queue">Current WIP and ready queue</h2>

<p class="flow-total not-content">
  <strong>Total WIP: {metrics.wip.count}</strong>
  <span>of {metrics.wip.limit} (In Progress and Delivery Initiated together)</span>
</p>

<div class="flow-columns not-content">
  {
    columns.map(({ id, label, kind, data }) => (
      <section class={kind === "queue" ? "flow-column flow-column-queue" : "flow-column"} aria-label={label}>
        <div class="flow-column-top">
          <h3>{label}</h3>
          <span class="flow-kind">{kind === "queue" ? "Ready queue" : "WIP"}</span>
        </div>
        <p class="flow-capacity">
          <strong>{data.count > 0 ? <a href={`#issues-${id}`}>{data.count}</a> : data.count}</strong>
          <span>of {data.limit} limit</span>
        </p>
        <div class="flow-track" aria-hidden="true">
          <span style={`width: ${percent(data.count, data.limit)}%`} />
        </div>
        {data.count > data.limit && <p class="flow-over-limit">Over limit by {data.count - data.limit}</p>}
        {data.issues.length ? (
          <ul class="flow-issues" id={`issues-${id}`}>
            {data.issues.map((issue: IssueLink) => (
              <li>
                <a href={issue.url}>
                  <span class="flow-issue-number">#{issue.number}</span>
                  <span>{issue.title}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="flow-empty">No work items in this column</p>
        )}
      </section>
    ))
  }
</div>

<p>
  The limits are {LIMITS.inProgress} for In Progress, {LIMITS.deliveryInitiated} for Delivery Initiated and {LIMITS.ready}
  for Ready. A number links to the issues behind it, and each issue opens on GitHub.
</p>

<h2 id="throughput">Throughput</h2>

<div class="flow-weeks not-content">
  {
    metrics.throughput.length ? (
      metrics.throughput.map((week) => (
        <section class="flow-week" aria-label={week.week}>
          <div class="flow-week-heading">
            <h3>
              {week.week} <small>{range(week.start, week.end)}</small>
            </h3>
            <p>
              <strong>
                <a href={`#issues-${week.week}`}>{week.count}</a>
              </strong>{" "}
              completed
            </p>
          </div>
          <div id={`issues-${week.week}`}>
            {week.workTypes.map((type) => (
              <div class="flow-type">
                <div class="flow-type-heading">
                  <h4>{type.name}</h4>
                  <span>
                    {type.count} of {week.count}
                  </span>
                </div>
                <div class="flow-type-track" aria-hidden="true">
                  <span style={`width: ${percent(type.count, week.count)}%`} />
                </div>
                <ul class="flow-issues">
                  {type.issues.map((issue: IssueLink) => (
                    <li>
                      <a href={issue.url}>
                        <span class="flow-issue-number">#{issue.number}</span>
                        <span>{issue.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      ))
    ) : (
      <p class="flow-empty">No completed work items in the sample.</p>
    )
  }
</div>
