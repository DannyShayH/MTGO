---
import FlowMetricsHeader from "./FlowMetricsHeader.astro"
import FlowDailyCounts from "./FlowDailyCounts.astro"
import FlowBreachTable from "./FlowBreachTable.astro"
import { metrics, columns, percent, flowUrl, average } from "../lib/flow-view.ts"

const oldCount = metrics.activeWork.filter((item) => item.old).length
const ongoingBreaches = metrics.wipBreaches.filter((breach) => breach.end === null)
const attention = [
  { label: "Blocked", count: metrics.blocked.length, anchor: "blocked" },
  { label: "Old work items", count: oldCount, anchor: "work-item-age" },
  { label: "Data problems", count: metrics.dataProblems.length, anchor: "data-problems" },
  { label: "Ongoing breaches", count: ongoingBreaches.length, anchor: "wip-limit-breaches" },
]
---
<div class="flow-page flow-dashboard">
  <FlowMetricsHeader current="overview" />
  <p class="flow-intro">A shared view for the flow review. Check capacity, find work that needs attention, and follow the trends.</p>

  <section class="flow-capacity-section not-content" aria-labelledby="current-wip-and-ready-queue">
    <div class="flow-section-heading">
      <h2 id="current-wip-and-ready-queue">Current capacity</h2>
      <p>Total WIP <strong>{metrics.wip.count} / {metrics.wip.limit}</strong></p>
    </div>
    <div class="flow-columns">
      {columns.map(({ id, label, kind, data }) => (
        <a class:list={["flow-capacity-card", { "flow-capacity-queue": kind === "queue", "flow-capacity-breach": data.count > data.limit }]} href={flowUrl(`work-items/#issues-${id}`)} aria-label={`${label}: ${data.count} work items, limit ${data.limit}. View work items.`}>
          <span class="flow-capacity-label">{label}</span>
          <span class="flow-capacity-value"><strong>{data.count}</strong><span>/ {data.limit} limit</span></span>
          <span class="flow-track" aria-hidden="true"><span style={`width: ${percent(data.count, data.limit)}%`} /></span>
          <span class="flow-capacity-note">{data.count > data.limit ? `Over limit by ${data.count - data.limit}` : kind === "queue" ? "Ready queue" : "Within WIP limit"}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="flow-attention-section not-content" aria-labelledby="review-attention">
    <div class="flow-section-heading"><h2 id="review-attention">For the flow review</h2><a href={flowUrl("work-items/")}>View work items</a></div>
    <div class="flow-attention">
      {attention.map(({ label, count, anchor }) => (
        <a class:list={["flow-attention-item", { "flow-attention-flag": count > 0 }]} href={flowUrl(`work-items/#${anchor}`)}>
          <strong>{count}</strong><span>{label}</span>
        </a>
      ))}
    </div>
    {ongoingBreaches.length > 0 && <ul class="flow-breach-notice">{ongoingBreaches.map((breach) => <li>{breach.column} is above its limit of {breach.limit}. Peak excess: {breach.peakExcess}.</li>)}</ul>}
  </section>

  <div class="flow-chart-grid">
    <section class="flow-panel not-content" aria-labelledby="throughput">
      <div class="flow-panel-heading"><h2 id="throughput">Throughput</h2><a href={flowUrl("definitions/#throughput")} aria-label="Throughput definition">Definition</a></div>
      <p class="flow-panel-description">Completed work items per week, by work type.</p>
      {metrics.throughput.length ? <>
        <div id="throughput-chart" class="flow-chart" role="img" aria-label="Weekly throughput by work type. Exact counts are available in Weekly totals below." />
        <details class="flow-disclosure"><summary>Weekly totals</summary>
          <div class="flow-table-wrap" role="region" aria-label="Weekly throughput totals" tabindex="0"><table class="flow-table"><thead><tr><th scope="col">Week</th><th scope="col">Completed</th></tr></thead><tbody>{metrics.throughput.map((week) => <tr><th scope="row">{week.week}</th><td>{week.count}</td></tr>)}</tbody></table></div>
        </details>
      </> : <p class="flow-panel-empty">No completed work items yet. Completed work will appear here after the next refresh.</p>}
      <a class="flow-detail-link" href={flowUrl("work-items/#throughput")}>View completed work items</a>
    </section>

    <section class="flow-panel not-content" aria-labelledby="cycle-time">
      <div class="flow-panel-heading"><h2 id="cycle-time">Cycle time</h2><a href={flowUrl("definitions/#cycle-time")} aria-label="Cycle time definition">Definition</a></div>
      <p class="flow-panel-description">Average calendar days from Start date to close.</p>
      {metrics.cycleTimeWeeks.length ? <>
        <div id="cycle-time-chart" class="flow-chart" role="img" aria-label="Average cycle time by closing week. Exact values are available in Weekly averages below." />
        <details class="flow-disclosure"><summary>Weekly averages</summary>
          <div class="flow-table-wrap" role="region" aria-label="Weekly cycle time averages" tabindex="0"><table class="flow-table"><thead><tr><th scope="col">Week</th><th scope="col">Average</th><th scope="col">Count</th></tr></thead><tbody>{metrics.cycleTimeWeeks.map((week) => <tr><th scope="row">{week.week}</th><td>{average(week.averageDays)}</td><td>{week.count}</td></tr>)}</tbody></table></div>
        </details>
      </> : <p class="flow-panel-empty">No completed work items have a usable Start date. Check data problems for missing dates.</p>}
      <a class="flow-detail-link" href={flowUrl("work-items/#cycle-time")}>View cycle time by work item</a>
    </section>

    <section class="flow-panel flow-panel-wide not-content" aria-labelledby="cumulative-flow">
      <div class="flow-panel-heading"><h2 id="cumulative-flow">Cumulative Flow Diagram</h2><a href={flowUrl("definitions/#cumulative-flow-diagram-cfd")} aria-label="Cumulative Flow Diagram definition">Definition</a></div>
      <p class="flow-panel-description">Daily counts per board status. Wider bands show where work accumulates.</p>
      {metrics.cumulativeFlow.length ? <>
        <div id="cumulative-flow-chart" class="flow-chart" role="img" aria-label="Daily work items per board status. Exact counts are available in Daily status counts below." />
        <details class="flow-disclosure"><summary>Daily status counts</summary><FlowDailyCounts /></details>
      </> : <p class="flow-panel-empty">No status history is available. Counts will appear after board data is collected.</p>}
      <p class="flow-chart-footnote">Copenhagen calendar days. The latest day ends at collection time. Earlier counts use the available history of items still on the board.</p>
    </section>
  </div>

  <section class="flow-history-section not-content" aria-labelledby="wip-limit-breaches">
    <div class="flow-section-heading"><h2 id="wip-limit-breaches">WIP limit breaches</h2><a href={flowUrl("definitions/#wip-limit-breaches")}>Counting rules</a></div>
    <p>{ongoingBreaches.length ? `${ongoingBreaches.length} ongoing at collection.` : "No ongoing breaches at collection."} {metrics.wipBreaches.length} periods in the available history, including the Ready queue.</p>
    {metrics.wipBreaches.length > 0 && <details class="flow-disclosure"><summary>View all breach periods</summary><FlowBreachTable /></details>}
    <a class="flow-detail-link" href={flowUrl("work-items/#wip-limit-breaches")}>Explore breach history</a>
  </section>
</div>

<script src="../charts/throughput-chart.ts"></script>
<script src="../charts/cycle-time-chart.ts"></script>
<script src="../charts/cumulative-flow-chart.ts"></script>
