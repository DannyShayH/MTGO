---
import FlowMetricsHeader from "./FlowMetricsHeader.astro"
import { metrics, days, moment, flowUrl } from "../lib/flow-view.ts"
import type { FeatureChild } from "../../scripts/flow-metrics.ts"
const age = (child: FeatureChild) => child.closedAt ? "Not applicable" : child.ageDays === null ? child.timingState : days(child.ageDays)
const cycle = (child: FeatureChild) => {
  if (!child.isWorkItem) return "Not available"
  if (!child.closedAt) return child.timingState === "Not available" ? "Not available" : "Not completed"
  if (child.closeReason === "NOT_PLANNED") return "Not applicable"
  return child.cycleDays === null ? "Not available" : days(child.cycleDays)
}
---
<div class="flow-page flow-evidence">
  <FlowMetricsHeader current="features" />
  <p class="flow-intro">Features connect capabilities to their required work and acceptance evidence. Counts describe delivered work items, not a percentage of business capability.</p>
  <p>Completion requires delivered required work and a later parent closure as completed. Archived Features stay in this view, and their direct children are read from GitHub even when they are archived or not on the board. That evidence never counts as work items. <a href={flowUrl("definitions/#feature-age-and-required-work")}>Read the evidence limits.</a></p>
  <p class="flow-table-hint">Focus the table and use the arrow keys, or scroll sideways, to read every column.</p>
  {[false, true].map((withdrawn) => <section>
  {withdrawn && <h2>Withdrawn Features</h2>}
  {withdrawn && <p>Abandoned capabilities are not completed delivery. Delivered children retain their work-item history.</p>}
  <div class="flow-table-wrap flow-feature-table not-content" role="region" aria-label={withdrawn ? "Withdrawn Features" : "Features"} tabindex="0">
    <table class="flow-table">
      <caption>{withdrawn ? "Withdrawn capabilities and evidence" : "Feature delivery and ongoing age"}</caption>
      <thead><tr><th scope="col">Feature</th><th scope="col">State</th><th scope="col">Required work delivered</th><th scope="col">Earliest Start date</th><th scope="col">Required delivery finish</th><th scope="col">Feature age</th><th scope="col">Completed Feature lead time</th><th scope="col">Details</th></tr></thead>
      <tbody>{metrics.features.filter((feature) => (feature.state === "Withdrawn") === withdrawn).map((feature) => <tr id={`feature-row-${feature.number}`}>
        <th scope="row"><a href={feature.url}>#{feature.number} {feature.title}</a>{feature.isArchived && " (archived)"}</th>
        <td>{feature.state}{withdrawn && <p>{feature.withdrawalReason ?? "Withdrawal reason is missing or ambiguous"}</p>}</td>
        <td>{feature.requiredCount ? feature.deliveredCount === null ? `Delivery count not available (${feature.requiredCount} required)` : `${feature.deliveredCount} of ${feature.requiredCount} required work items delivered` : feature.children.length ? "No required work items" : "No work items yet"}{feature.removedChildren.length ? `; ${feature.removedChildren.length} removed` : ""}</td>
        <td>{feature.startedAt ? <time datetime={feature.startedAt}>{feature.startedAt}</time> : feature.timingState}</td>
        <td>{withdrawn ? "Not applicable" : feature.finishedAt ? <time datetime={feature.finishedAt}>{feature.finishedAt}</time> : feature.state === "Not available" ? "Not available" : "Not completed"}</td>
        <td>{["Completed", "Withdrawn"].includes(feature.state) ? "Not applicable" : feature.ageDays === null ? feature.timingState : days(feature.ageDays)}</td>
        <td>{withdrawn ? "Not applicable" : feature.leadTimeDays === null ? feature.state === "Not available" ? "Not available" : "Not completed" : days(feature.leadTimeDays)}</td>
        <td><a href={`#feature-${feature.number}`}>Work items and evidence</a></td>
      </tr>)}</tbody>
    </table>
  </div>
  </section>)}
  {!metrics.features.length && <p>No Features in this dataset.</p>}
  <h2>Feature work items and evidence</h2>
  {metrics.features.map((feature) => <details class="flow-disclosure" id={`feature-${feature.number}`}>
    <summary>#{feature.number} {feature.title}: work items and evidence</summary>
    <p><a href={feature.url}>Open Feature #{feature.number} on GitHub</a></p>
    {feature.state === "Withdrawn" ? <p>Withdrawal reason: {feature.withdrawalReason ?? "Not available (missing or ambiguous)"}. This capability was not delivered.</p> : <p>Parent acceptance: {feature.acceptedAt ? <time datetime={feature.acceptedAt}>{moment(feature.acceptedAt)}</time> : "Not recorded after required delivery"}. The measured finish is the latest required delivery, even when acceptance is recorded later.</p>}
    {feature.problems.length > 0 && <ul aria-label={`Feature ${feature.number} data problems`}>{feature.problems.map((problem) => <li><a href={problem.url}>#{problem.number} {problem.title}</a>: {problem.problem}</li>)}</ul>}
    {feature.children.length ? <div class="flow-table-wrap flow-feature-children not-content" role="region" aria-label={`Feature ${feature.number} children`} tabindex="0">
      <table class="flow-table">
        <thead><tr><th scope="col">Scope</th><th scope="col">Work item</th><th scope="col">Current status</th><th scope="col">Start date</th><th scope="col">Close date</th><th scope="col">Work item age</th><th scope="col">Cycle time</th></tr></thead>
        <tbody>{feature.children.map((child) => <tr>
          <td>{child.scope}</td>
          <th scope="row"><a href={child.url}>#{child.number} {child.title}</a></th>
          <td>{child.status}{child.isArchived && " (archived)"}{child.reopened && " (reopened work)"}{child.closeReason === "NOT_PLANNED" && " (closed without delivery)"}</td>
          <td>{child.startedAt ? <time datetime={child.startedAt}>{child.startedAt}</time> : child.timingState}</td>
          <td>{child.closedAt ? <time datetime={child.closedAt}>{moment(child.closedAt)}</time> : child.isWorkItem && child.timingState !== "Not available" ? "Not completed" : "Not available"}</td>
          <td>{age(child)}</td>
          <td>{cycle(child)}</td>
        </tr>)}</tbody>
      </table>
    </div> : <p>{feature.requiredCount ? "Child evidence is not available." : "No work items yet."}</p>}
    {feature.removedChildren.length > 0 && <div><p>Removed scope is excluded from current required-work counts and finish selection. Each removed child remains part of the historical start evidence.</p><ul aria-label={`Feature ${feature.number} removed scope reasons`}>{feature.removedChildren.map((child) => <li>#{child.number}: {child.removalReason}</li>)}</ul></div>}
  </details>)}
</div>
