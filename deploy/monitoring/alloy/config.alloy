// Collects approved application events into Loki (#176, #177).
//
// Source selection is bounded to three Compose services of the application
// project named by MTOGO_LOG_PROJECT (local demo: mtogo-monitoring-demo,
// staging: mtogo-staging): backend, partner and storefront. Database, Redis,
// Caddy, the worker, other services, one-off `run` containers and unrelated
// projects are never read. The Docker socket gives read access to every
// container's logs and metadata; see the runbook before mounting it on a
// shared host.

// Docker ANDs the values of one label filter, so the services are selected
// by the relabel rule below.
discovery.docker "application" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "15s"

  filter {
    name   = "label"
    values = [
      "com.docker.compose.project=" + sys.env("MTOGO_LOG_PROJECT"),
      "com.docker.compose.oneoff=False",
    ]
  }
}

// The only label set here is the container's Compose service. The pipeline
// accepts a record only when its own service equals it, then drops the label.
discovery.relabel "application" {
  targets = discovery.docker.application.targets

  rule {
    action        = "keep"
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "backend|partner|storefront"
  }

  rule {
    action        = "replace"
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "source_service"
  }

  // Alloy stores a container's read position under its whole label set (#178).
  // Docker's labels include its network address, which a restart can change;
  // the position would be lost and the log read again. The ID and the service
  // identify a container for its whole life. Changing this set, or the name of
  // loki.source.docker below, loses every stored position once.
  rule {
    action = "labelkeep"
    regex  = "__meta_docker_container_id|source_service"
  }
}

loki.source.docker "application" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.application.output
  refresh_interval = "15s"
  forward_to       = [approved.application_events.application.receiver]
}

import.file "approved" {
  filename = "/etc/alloy/approved-events.alloy"
}

approved.application_events "application" {
  forward_to = [loki.write.local.receiver]
}

// Best effort: a bounded retry, never a wait inside the application.
loki.write "local" {
  endpoint {
    url                 = "http://loki:3100/loki/api/v1/push"
    max_backoff_retries = 10
  }
}
