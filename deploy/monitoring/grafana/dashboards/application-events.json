{
  "uid": "mtogo-application-events",
  "title": "MTOGO — approved application events",
  "description": "Approved backend, partner and storefront events, rebuilt from allowlisted fields by Alloy before Loki (#176, #177). Framework, startup and Next.js server output is not here; it stays in Docker logs.",
  "schemaVersion": 41,
  "version": 2,
  "editable": false,
  "refresh": "30s",
  "timezone": "utc",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": ["mtogo", "logs"],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Application",
        "type": "custom",
        "query": "backend,partner,storefront",
        "multi": true,
        "includeAll": true,
        "allValue": "backend|partner|storefront",
        "current": {
          "text": ["All"],
          "value": ["$__all"]
        },
        "options": []
      },
      {
        "name": "level",
        "label": "Severity",
        "type": "custom",
        "query": "info,warn,error",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": ["All"],
          "value": ["$__all"]
        },
        "options": []
      },
      {
        "name": "event",
        "label": "Event starts with",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "request_id",
        "label": "Request ID starts with",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "What this shows",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Only **recognized events from the backend, partner and storefront** reach this view, rebuilt from the logging allowlist. Raw framework, startup, Next.js server and provider lines stay in `docker compose logs`. Database, Redis, Caddy, the worker and browser output are never collected.\n\n**No events** with a healthy pipeline means no matching approved event happened in the time range; it does not mean nothing happened. Not every request logs an event, and the storefront logs only failed backend calls.\n\n**Request IDs correlate only where the apps already share one:** partner server calls that forward their `request_id` to the backend, such as sign-in. Storefront records share no ID with the backend, and there is no tracing. A missing event under an ID is not proof the step did not happen.\n\n**Live tail:** set refresh to 5s (top right) or add `&refresh=5s` to the URL."
      }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Approved application events",
      "datasource": {
        "type": "loki",
        "uid": "mtogo-loki"
      },
      "gridPos": {
        "h": 20,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "mtogo-loki"
          },
          "queryType": "range",
          "expr": "{service=~\"${service:regex}\", level=~\"${level:regex}\"} | json | event=~\"${event:regex}.*\" | request_id=~\"${request_id:regex}.*\""
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Approved events by application and severity — per bar",
      "datasource": {
        "type": "loki",
        "uid": "mtogo-loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "mtogo-loki"
          },
          "queryType": "range",
          "legendFormat": "{{service}} {{level}}",
          "expr": "sum by (service, level) (count_over_time({service=~\"${service:regex}\", level=~\"${level:regex}\"} [$__auto]))"
        }
      ],
      "description": "Each bar counts every approved event in its own time bucket ($__auto: the bar width Grafana picks for the displayed range), so long ranges are not sampled."
    }
  ],
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  }
}
