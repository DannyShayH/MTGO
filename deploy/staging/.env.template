# /srv/mtogo-staging/.env on the Droplet: owner root, mode 600, never in Git.
# Plain KEY=VALUE lines without quotes or spaces. The deploy script reads the
# STAGING_* values, Docker Compose reads all of them (deploy/staging/compose.yaml).

# Public HTTPS origins served by the existing Caddy, without trailing slash.
STAGING_STOREFRONT_URL=https://staging.example.org
STAGING_BACKEND_URL=https://api.staging.example.org
STAGING_PARTNER_URL=https://partner.staging.example.org

# Release images, pushed by the Deploy workflow: <prefix>-backend, -partner, -storefront.
STAGING_IMAGE_PREFIX=ghcr.io/dannyshayh/mtgo-staging

# Where the three application ports are published for Caddy. 127.0.0.1 when
# Caddy runs on the host; the docker0 gateway (usually 172.17.0.1) when Caddy
# runs in its own container. Never 0.0.0.0.
STAGING_BIND_ADDRESS=127.0.0.1
STAGING_BACKEND_PORT=9000
STAGING_STOREFRONT_PORT=8000
STAGING_PARTNER_PORT=8100

# Region of the initial seed; the storefront build and health check use it.
STAGING_DEFAULT_REGION=dk

# The existing PostgreSQL 16 container and its Docker network. Find the network
# with: docker inspect db --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}'
STAGING_DB_NETWORK=
STAGING_DB_HOST=db
STAGING_DB_PORT=5432
# The staging database and its restricted owner, created by the admin's SQL.
# The name must start with mtogo_staging: the synthetic seeds check it.
STAGING_DB_NAME=mtogo_staging
STAGING_DB_USER=mtogo_staging_app
# Part of a URL: letters and digits only (for example: openssl rand -hex 24).
STAGING_DB_PASSWORD=

# Medusa secrets (for example: openssl rand -hex 32 each). Changing them signs
# every admin, staff and customer out.
JWT_SECRET=
COOKIE_SECRET=

# Private Tigris mtogo bucket. Enter the bucket-scoped read/write key on the
# Droplet. Compose pins the endpoint, region, bucket and unsigned file base.
PHOTO_S3_ACCESS_KEY_ID=
PHOTO_S3_SECRET_ACCESS_KEY=

# Resend, for Customer verification emails (domain corral.dk, EU region). Without
# the key the backend only logs emails and nobody can verify a new account.
# RESEND_FROM_EMAIL is optional and defaults to: MTogo <noreply@corral.dk>
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# openrouteservice free Standard key for trip and pickup distances in the
# Delivery agent workspace. Optional: without it distances show as unavailable.
ORS_API_KEY=

# Feature flags (ADR-0022), off unless set to true here. Staging releases
# Feedback (#51); change it and restart the backend, no new build is needed.
MTOGO_FF_FEEDBACK=true
# Restaurant statements (#52): the Order's financial basis (#226) and later
# statement pages.
MTOGO_FF_RESTAURANT_STATEMENTS=true

# false (default): one backend process in Medusa's shared mode, for a 2 GB
# Droplet. true: backend in server mode plus a separate worker container.
STAGING_SPLIT_WORKER=false

# Optional: Node heap for the backend (and worker) containers, in MB.
BACKEND_HEAP_MB=512

# Private request metrics (#194). 1 opens the backend's exporter on the
# internal mtogo-staging-metrics network for the separate monitoring stack;
# 0 (default) leaves it off. `mtogo-deploy.sh monitoring up` applies it and
# starts Prometheus and Grafana; otherwise it applies at the next deploy.
STAGING_METRICS_ENABLED=0
# Grafana for the monitoring stack, served by Caddy on this public origin.
# Its port is published on STAGING_BIND_ADDRESS, like the application ports.
STAGING_GRAFANA_URL=https://grafana.staging.example.org
STAGING_GRAFANA_PORT=3300
# staging-admin password, letters and digits, at least 24 (openssl rand -hex 24).
# Grafana stores it on its first start only; changing it later has no effect.
GRAFANA_ADMIN_PASSWORD=
