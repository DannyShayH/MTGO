# Site blocks for the Caddy that already runs on the Droplet. Replace the
# hostnames with the values of STAGING_*_URL in /srv/mtogo-staging/.env and
# the upstreams with STAGING_BIND_ADDRESS and the three ports.
#
# Caddy in its own container cannot reach 127.0.0.1 of the host: set
# STAGING_BIND_ADDRESS to the docker0 gateway (usually 172.17.0.1) and use that
# address as the upstream, or give the Caddy container
# extra_hosts: ["host.docker.internal:host-gateway"] and proxy to
# host.docker.internal.

staging.example.org {
	encode gzip
	reverse_proxy 127.0.0.1:8000
}

api.staging.example.org {
	encode gzip
	# Admin dashboard: /app. Store API: /store. Uploads: /static.
	reverse_proxy 127.0.0.1:9000
}

# The partner kitchen feed (#148) needs no extra directives: the backend and
# the partner relay send it with "Cache-Control: no-cache, no-transform", so
# encode leaves it uncompressed, and reverse_proxy flushes text/event-stream
# responses immediately.
partner.staging.example.org {
	encode gzip
	reverse_proxy 127.0.0.1:8100
}

# Optional request monitoring (#194): Grafana only, behind its own login.
# Prometheus and the backend exporter never get a route. The upstream is
# STAGING_BIND_ADDRESS and STAGING_GRAFANA_PORT. Server administration answers
# 404 here; the admin manages Viewers with `mtogo-deploy.sh monitoring`.
grafana.staging.example.org {
	encode gzip
	@server_admin path /admin /admin/* /api/admin/*
	respond @server_admin 404
	reverse_proxy 127.0.0.1:3300
}
