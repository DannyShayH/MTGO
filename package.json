{
  "name": "mtogo",
  "private": false,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=11.19.1"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront",
    "arch": "depcruise apps --config .dependency-cruiser.cjs",
    "arch:graph": "depcruise apps/backend/src --config .dependency-cruiser.cjs --output-type mermaid --collapse \"^apps/backend/src/[^/]+\"",
    "verify:applications": "node scripts/verify-applications.mjs",
    "verify:admin-development": "node scripts/verify-admin-development.mjs"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5",
      "tsconfig-paths": "^4.2.0"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.22.4",
    "ajv": "^8.13.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.0.14"
  },
  "workspaces": [
    "apps/**",
    "!apps/backend/.medusa/**"
  ],
  "overrides": {
    "eslint": {
      "ajv": "^6.12.4"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.4"
    },
    "@rushstack/node-core-library": {
      "ajv": "^8.18.0"
    }
  },
  "allowScripts": {
    "@swc/core@1.16.21": true,
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.6": true,
    "protobufjs@7.6.6": true,
    "@medusajs/telemetry@2.22.4": true,
    "fsevents": false
  }
}
