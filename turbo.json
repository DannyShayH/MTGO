{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["eslint.config.ts"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "seed": {
      "outputs": []
    },
    "@dtc/backend#build": {
      "dependsOn": ["^build"],
      "outputs": [".medusa/server/**", ".medusa/types/**"],
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "STORE_CORS",
        "ADMIN_CORS",
        "AUTH_CORS",
        "JWT_SECRET",
        "COOKIE_SECRET",
        "MEDUSA_*",
        "VITE_*"
      ]
    },
    "@dtc/storefront#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**"],
      "env": [
        "NODE_ENV",
        "NEXT_PUBLIC_*",
        "NEXT_TELEMETRY_DISABLED",
        "MEDUSA_CLOUD_S3_*"
      ]
    },
    "@dtc/partner#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["NODE_ENV", "MEDUSA_BACKEND_URL", "NEXT_TELEMETRY_DISABLED"]
    }
  }
}
